# Nessun valore in questo file: e' solo la documentazione di quali segreti
# servono e con quale nome. I valori reali non vanno mai qui ne' altrove nel
# repository — vanno in GitHub → Settings → Secrets and variables → Actions
# (vedi README.md, sezione "Deploy su Cloudflare").

# Token API Cloudflare con permesso di deploy su Workers (e R2, se si usa
# anche `pnpm upload:img` in locale).
CLOUDFLARE_API_TOKEN=

# ID dell'account Cloudflare che ospita il Worker e il bucket R2.
CLOUDFLARE_ACCOUNT_ID=
