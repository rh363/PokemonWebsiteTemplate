# Copia questo file in .env (che git ignora) e compila cio' che ti serve.
# Tutto e' facoltativo: senza, valgono i default scritti in
# src/config/site.ts e astro.config.mjs, e il sito funziona lo stesso.
#
# Le variabili PUBLIC_* vengono lette DURANTE IL BUILD e finiscono nell'HTML
# e nei bundle: non sono un posto dove mettere segreti, e cambiarle richiede
# un nuovo build (per il deploy: Actions -> Run workflow, oppure un push).

# Dominio pubblico del sito. Da qui escono canonical, og:url, sitemap e i
# dati strutturati del negozio.
# PUBLIC_SITE_URL="https://cartafolia.it"

# Bucket R2 con le foto delle carte: dominio personalizzato, oppure l'URL
# pubblico r2.dev per fare prove. Vuoto = placeholder foil su ogni carta.
# PUBLIC_IMG_ORIGINE="https://pub-xxxxxxxx.r2.dev"

# Zona Cloudflare su cui girano le trasformazioni delle immagini: di norma
# il dominio del sito. Facoltativa, e serve un dominio proprio (non esiste
# su .workers.dev). Vuota = foto originali servite dal bucket, senza
# ridimensionamento. Vedi docs/CONTENUTI.md.
# PUBLIC_IMG_ZONA="https://cartafolia.it"

# Nome del bucket per `pnpm upload:img`. Non serve al sito: lo usa solo lo
# script di caricamento.
# R2_BUCKET="cartafolia-carte"
