{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nome del Worker su Cloudflare: e' anche il sottodominio di default
  //   (<name>.<sottodominio-account>.workers.dev) finche' non si collega un
  //   dominio proprio. Vedi README.md, sezione "Deploy su Cloudflare".
  "name": "pokemonwebsitetemplate",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // Nessun campo "main": questo e' un Worker solo-asset statici (l'output
  // di `astro build`, output: 'static'). Le richieste servite dalla parte
  // "assets" di un Worker sono gratuite e non consumano la quota di
  // richieste del piano Workers Free — vedi la doc Cloudflare "Workers
  // Static Assets".
}
