---
// Galleria di verifica per i primitivi del design system (Task 9).
// Sviluppo soltanto: rimossa alla pulizia finale. Non e' una pagina del sito.
//
// Nota: il piano indicava `src/pages/__ds.astro`, ma Astro esclude dal
// routing qualunque file di pagina il cui nome inizia con underscore (vedi
// astro/dist/core/routing/create-manifest.js: e' il meccanismo con cui si
// co-locano file non-pagina dentro src/pages/). Con quel nome la rotta
// risponderebbe sempre 404, sia in dev che in build. Rinominato in
// `ds-gallery.astro`, servito su /ds-gallery.
import '~/styles/global.css'
import CardArt from '~/components/ds/CardArt.svelte'
import RarityBadge from '~/components/ds/RarityBadge.svelte'
import ConditionBadge from '~/components/ds/ConditionBadge.svelte'
import Badge from '~/components/ds/Badge.svelte'
import SpecList from '~/components/ds/SpecList.svelte'
import Skeleton from '~/components/ds/Skeleton.svelte'
import EmptyState from '~/components/ds/EmptyState.svelte'
import Icon from '~/components/ds/Icon.svelte'
import Button from '~/components/ds/Button.svelte'
import IconButton from '~/components/ds/IconButton.svelte'
import Chip from '~/components/ds/Chip.svelte'
import Panel from '~/components/ds/Panel.svelte'
import Tooltip from '~/components/ds/Tooltip.svelte'
import Input from '~/components/ds/Input.svelte'
import DsForms from '~/components/islands/DsForms.svelte'

const RARITA = ['common', 'uncommon', 'rare', 'holo', 'ultra', 'secret'] as const
const COND = ['mint', 'near-mint', 'excellent', 'good', 'played'] as const
const TONI = ['neutral', 'brand', 'accent', 'success', 'warning', 'danger', 'foil', 'invert'] as const

const SPEC_ITEMS = [
  { label: 'Espansione', value: 'Alba Cromatica' },
  { label: 'Numero', value: '042/198', mono: true },
  { label: 'Lingua', value: 'Italiano' },
]

const BTN_VARIANTI = ['primary', 'secondary', 'ghost', 'foil', 'invert'] as const
const BTN_TAGLIE = ['sm', 'md', 'lg'] as const
const ICONBTN_VARIANTI = ['secondary', 'ghost', 'brand', 'invert'] as const
const PANEL_VARIANTI = ['card', 'sunken', 'sticker', 'invert', 'foil'] as const
const TOOLTIP_LATI = ['top', 'bottom', 'left', 'right'] as const
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>DS — galleria primitivi</title>
  </head>
  <body>
    <div class="wrap sez" style="display:grid;gap:var(--sp-8)">
      <h1 style="font:var(--type-hero);letter-spacing:var(--ls-display-xl)">Galleria DS — Task 9-10</h1>

      <h2>CardArt — una per rarità</h2>
      <div class="cards">
        {RARITA.map((r) => <CardArt rarity={r} code="ALB 042/198" />)}
      </div>

      <h2>RarityBadge — md e sm</h2>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
        {RARITA.map((r) => <RarityBadge rarity={r} />)}
      </div>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
        {RARITA.map((r) => <RarityBadge rarity={r} size="sm" />)}
      </div>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
        {RARITA.map((r) => <RarityBadge rarity={r} showLabel={false} />)}
      </div>

      <h2>ConditionBadge — pieno e compatto</h2>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
        {COND.map((c) => <ConditionBadge condition={c} />)}
      </div>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap">
        {COND.map((c) => <ConditionBadge condition={c} compact />)}
      </div>

      <h2>SpecList — piena e compatta</h2>
      <div class="g2" style="max-width:640px">
        <SpecList items={SPEC_ITEMS} />
        <SpecList items={SPEC_ITEMS} dense />
      </div>

      <h2>Badge — tutti i toni</h2>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center">
        {TONI.map((t) => <Badge tone={t}>{t}</Badge>)}
      </div>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center">
        <Badge tone="brand" uppercase={false}>senza maiuscolo</Badge>
        <Badge tone="success">
          <Icon slot="icon" name="check" size={12} />
          con icona
        </Badge>
      </div>

      <h2>Skeleton — forme</h2>
      <div class="cards">
        <Skeleton shape="card" />
        <div style="display:grid;gap:8px">
          <Skeleton shape="title" />
          <Skeleton count={3} />
        </div>
        <Skeleton shape="circle" width={56} height={56} />
      </div>

      <h2>EmptyState — pieno e compatto, con azione</h2>
      <div class="g2">
        <EmptyState title="Nessuna carta trovata" description="Prova a modificare i filtri di ricerca." />
        <EmptyState title="Nessun risultato" compact />
      </div>
      <EmptyState title="Catalogo vuoto" description="Aggiungi carte per iniziare.">
        <Badge slot="action" tone="brand">Aggiungi carta</Badge>
      </EmptyState>

      <h1 style="font:var(--type-hero);letter-spacing:var(--ls-display-xl)">Task 10 — controlli</h1>

      <h2>Button — 5 varianti × 3 taglie</h2>
      {
        BTN_VARIANTI.map((v) => (
          <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center;margin-bottom:8px">
            {BTN_TAGLIE.map((s) => (
              <Button id={`btn-${v}-${s}`} variant={v} size={s}>
                {v} {s}
              </Button>
            ))}
          </div>
        ))
      }
      <h3>Button — disabled e fullWidth</h3>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center">
        <Button variant="primary" disabled>
          Non disponibile
        </Button>
        <Button variant="secondary" as="a" href="#link">
          Link come bottone
        </Button>
      </div>
      <div style="max-width:360px">
        <Button variant="primary" fullWidth>
          Larghezza piena
        </Button>
      </div>

      <h2>IconButton — 4 varianti × 3 taglie</h2>
      {
        ICONBTN_VARIANTI.map((v) => (
          <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center;margin-bottom:8px">
            {BTN_TAGLIE.map((s) => (
              <IconButton id={`iconbtn-${v}-${s}`} variant={v} size={s} icon="heart" label={`${v} ${s}`} />
            ))}
          </div>
        ))
      }
      <h3>IconButton — active e disabled</h3>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center">
        <IconButton variant="secondary" icon="heart" label="Preferito attivo" active />
        <IconButton variant="secondary" icon="heart" label="Non disponibile" disabled />
      </div>

      <h2>Chip — con e senza rimozione</h2>
      <div style="display:flex;gap:var(--sp-3);flex-wrap:wrap;align-items:center">
        <Chip onclick={() => {}}>Alba Cromatica</Chip>
        <Chip onclick={() => {}} selected>
          Selezionato
        </Chip>
        <Chip onclick={() => {}} count={12}>
          Con contatore
        </Chip>
        <Chip onclick={() => {}} onRemove={() => {}}>
          Rimovibile
        </Chip>
        <Chip disabled>Disabilitato</Chip>
        <Chip>Non interattivo</Chip>
      </div>

      <h2>Panel — 5 skin, con e senza hoverLift</h2>
      <div class="g3">
        {
          PANEL_VARIANTI.map((v) => (
            <Panel id={`panel-${v}`} variant={v} hoverLift>
              <strong>{v}</strong> — hoverLift
            </Panel>
          ))
        }
      </div>
      <div class="g3">
        {
          PANEL_VARIANTI.map((v) => (
            <Panel variant={v}>
              <strong>{v}</strong> — senza hoverLift
            </Panel>
          ))
        }
      </div>

      <h2>Tooltip — 4 lati</h2>
      <div style="display:flex;gap:var(--sp-16);flex-wrap:wrap;align-items:center;padding:var(--sp-16) 0">
        {
          TOOLTIP_LATI.map((s) => (
            <Tooltip label={`Lato ${s}`} side={s}>
              <Button id={s === 'top' ? 'tooltip-top-trigger' : undefined} variant="secondary" size="sm">
                {s}
              </Button>
            </Tooltip>
          ))
        }
      </div>

      <h1 style="font:var(--type-hero);letter-spacing:var(--ls-display-xl)">Task 11 — campi e filtri</h1>

      <h2>Input — dimensioni, hint, errore, icona</h2>
      <div class="g3" style="align-items:start">
        <Input id="input-sm" label="Nome carta" size="sm" placeholder="Charizard" />
        <Input id="input-md" label="Nome carta" hint="Cerca per nome esatto" placeholder="Charizard" />
        <Input id="input-lg" label="Nome carta" size="lg" placeholder="Charizard" />
        <Input id="input-error" label="Codice set" error="Codice non valido" value="ALB-999" />
        <Input id="input-disabled" label="Non modificabile" value="Bloccato" disabled />
        <Input id="input-icon" label="Prezzo" placeholder="0,00">
          <Icon slot="icon" name="sparkles" size={16} />
          <span slot="suffix" style="font:var(--type-code);color:var(--text-faint)">EUR</span>
        </Input>
      </div>

      <h2>SearchField, Select, Checkbox, Switch, FilterGroup — isola con stato</h2>
      <p style="font:var(--type-body);color:var(--text-muted);max-width:640px">
        Questi cinque componenti hanno stato vero (valore, apertura): sono montati dentro
        <code>DsForms.svelte</code>, l'unica isola idratata di questa galleria (<code>client:load</code>).
        Prova la tastiera: Tab su ogni campo, Spazio su Checkbox/Switch, Invio sul titolo del
        filtro, frecce + Invio + Esc nei suggerimenti della ricerca.
      </p>
      <DsForms client:load />
    </div>
  </body>
</html>
